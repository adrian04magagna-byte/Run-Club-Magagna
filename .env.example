# Copie para .env (que não vai para o git) e preencha. Em produção, cadastre na Vercel.

# Banco Postgres. Produção: string do "Transaction pooler" do Supabase (porta 6543).
# Local: pglite:./.local-db cria um Postgres embutido nesta pasta, sem instalar nada.
DATABASE_URL=pglite:./.local-db

# Segredo que assina as sessões. Gere com: openssl rand -hex 32
SESSION_SECRET=

# E-mail do treinador e código exigido no "Primeiro acesso" com e-mail e senha.
COACH_EMAIL=
COACH_SIGNUP_CODE=

# URL pública da API (sem barra no final). Local: http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Origens web que podem chamar a API, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:8081

# Endereços para onde o login com Google pode voltar (correspondência exata).
APP_RETURN_URLS=http://localhost:8081/oauth/callback,runclubmagagna://oauth/callback

# Login com Google (Google Cloud Console > Credenciais > ID do cliente OAuth "Aplicativo da Web").
# URI de redirecionamento autorizado: <EXPO_PUBLIC_API_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Strava (opcional): somente no servidor.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_TOKEN_ENCRYPTION_KEY=
